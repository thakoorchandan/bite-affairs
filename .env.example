# ─────────────────────────────────────────────────────────────────────────────
# Bite Affairs — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE SWITCH ──────────────────────────────────────────────────────────
# local  = the local dev database (start it with `npm run dev:db`; URL below). Never allowed in production.
# remote = your real database (DATABASE_URL below). Default when unset.
# Flip it with:  npm run db:use -- local   |   npm run db:use -- remote   (check: npm run db:check)
DB_MODE=remote
LOCAL_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# REQUIRED · Supabase Postgres, SESSION pooler (port 5432). Shared by the store AND the admin app.
# Do NOT use the transaction pooler (6543): the postgres.js driver pipelines concurrent queries, which hang there.
# See SUPABASE_SETUP.md. Used when DB_MODE=remote.
DATABASE_URL=
# Session pooler (port 5432), used only by migrations/scripts.
DIRECT_URL=
# Max connections per app. The Supabase free (nano) pooler allows ~15 session connections in total, and the
# store and admin each open up to this many, so keep it at 5 or below.
DATABASE_POOL_MAX=5

# REQUIRED · Secret for signing sessions and order-tracking tokens.
# Generate: openssl rand -base64 32   (changing it signs everyone out and invalidates tracking links)
AUTH_SECRET=
# Public URL of THIS app (no trailing slash). next-auth uses it for callbacks.
# Store and admin are separate apps: in the admin app these must be the ADMIN origin
# (e.g. http://localhost:3001, https://admin.example.com). Use the SAME AUTH_SECRET in both apps.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED for `npm run create-admin` only. Long random string; you'll be asked to re-type it.
ADMIN_BOOTSTRAP_SECRET=
# Optional default for the admin email prompt.
ADMIN_EMAIL=

# OPTIONAL · Cloudinary (Free plan) for product images/videos. Without it, media uploads are disabled
# and the site uses the bundled menu imagery. Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for uploads (default: bite-affairs)
CLOUDINARY_FOLDER=bite-affairs

# OPTIONAL · Razorpay online payments. Cash on Delivery works without these.
# Use test keys (rzp_test_…) until you complete Razorpay KYC. Also enable it in Admin → Settings → Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → URL: <your-site>/api/payments/razorpay/webhook,
# events: payment.captured, payment.failed. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# OPTIONAL · Google Maps JavaScript/Embed key. Not required: "Open in Google Maps" links work without a key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OPTIONAL · Email notifications via Resend (free tier). Without these, emails are skipped.
RESEND_API_KEY=
EMAIL_FROM=Bite Affairs <orders@your-verified-domain.com>

# OPTIONAL · Official WhatsApp Business Cloud API (Meta). Requires an approved template named
# "order_status_update" with 3 body parameters (name, order number, status).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en

# OPTIONAL · Shared secret for the cron endpoint (/api/cron/maintenance) that expires unpaid
# orders and raises delayed-order alerts. Call it from a free cron service, e.g. cron-job.org.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Admin → storefront cache refresh (only needed when admin and store are deployed as SEPARATE apps)
# After the admin edits the menu/settings/content, it POSTs the changed cache tags to the store so customers
# see the change immediately. Use the SAME REVALIDATE_SECRET in both apps (openssl rand -base64 32).
# ─────────────────────────────────────────────────────────────────────────────
# Public URL of the storefront app (no trailing slash), set in the ADMIN app.
STORE_URL=
# Shared secret, set in BOTH apps. If unset in the store, /api/revalidate is disabled (503).
REVALIDATE_SECRET=

# Public storefront URL, used by the admin app for "View storefront" links.
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# OPTIONAL · "Continue with Google" on the storefront. Without these the button is hidden.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application).
# Authorised redirect URI: <store URL>/api/auth/callback/google  (local: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
