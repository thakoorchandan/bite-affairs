{
  "name": "bite-affairs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/store",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:db": "tsx scripts/local-db.ts",
    "db:use": "node scripts/db-use.mjs",
    "env:link": "node scripts/env-link.mjs",
    "build": "npm run build -w apps/store",
    "build:admin": "npm run build -w apps/admin",
    "build:all": "npm run build -w apps/store && npm run build -w apps/admin",
    "start": "npm run start -w apps/store",
    "start:admin": "npm run start -w apps/admin",
    "lint": "npm run lint -w apps/store",
    "lint:all": "npm run lint -w apps/store && npm run lint -w apps/admin",
    "typecheck": "npm run typecheck -w apps/store",
    "typecheck:all": "npm run typecheck -w apps/store && npm run typecheck -w apps/admin",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck:all && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "export-db": "tsx scripts/export-database.ts",
    "extract-images": "node scripts/extract-reference-images.mjs",
    "demo": "tsx scripts/demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.13",
    "@hookform/resolvers": "^6.0.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
